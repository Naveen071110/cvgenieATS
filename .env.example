# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=

# Database Configuration (PostgreSQL / Neon)
# e.g., postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Clerk Authentication
# Frontend publishable key (Use a Clerk Development instance key starting with pk_test_)
VITE_CLERK_PUBLISHABLE_KEY=
# Backend secret key (Use a Clerk Development instance secret starting with sk_test_)
CLERK_SECRET_KEY=

# DeepSeek AI Configuration (for resume optimization & cover letters)
# e.g., sk-...
DEEPSEEK_API_KEY=

# Dodo Payments Configuration
# Mode: 'test_mode' or 'live_mode'
DODO_PAYMENTS_MODE=test_mode
DODO_PAYMENTS_API_KEY=
# Product ID starting with pdt_ or prod_
DODO_PAYMENTS_PRODUCT_ID=
# Webhook secret for validating incoming Dodo payment events
DODO_PAYMENTS_WEBHOOK_SECRET=
